{
  "name": "agency-leadflow-crm",
  "version": "1.0.0",
  "description": "Мини-CRM для заявок агентства с поддержкой Telegram бота, тегами и real-time воронкой",
  "main": "server/index.js",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
